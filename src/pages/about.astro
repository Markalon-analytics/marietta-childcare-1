---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LeadCTA from '../components/LeadCTA.astro';
import PageHero from '../components/PageHero.astro';
import { images, siteInfo } from '../data/site';
---

<BaseLayout
  title="About Marietta Childcare | Marietta Childcare"
  description="Learn how Marietta parents can compare nearby BBMA child care locations by commute, programs, hours, safety, communication, and enrollment fit."
>
  <PageHero
    title="About Marietta Childcare"
    description="Compare nearby Big Blue Marble Academy options by the details that shape daily life: age group, commute, classroom routines, safety, communication, and fit."
    image={images.garden}
    eyebrow="About this location"
  />

  <section class="py-16">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="text-sm font-black uppercase tracking-widest text-primary">What to expect</p>
        <h2 class="mt-2 text-4xl font-black leading-tight">A BBMA visit should make the day easier to picture.</h2>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-[#111815]/75">
        <p>
          Choosing child care is not an abstract decision. You need to know which BBMA location fits your commute, who your child will spend the day with, how the room feels, how teachers communicate, and whether the schedule works for your week.
        </p>
        <p>
          Think through nearby Big Blue Marble Academy locations before you schedule a tour for infants, toddlers, twos, threes, fours, or school-age care.
        </p>
      </div>
    </div>
  </section>

  <section class="grid gap-6 pb-16 md:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-lg bg-white p-6 shadow-sm">
      <Icon name="clock" class="mb-4 size-7 text-primary" />
      <h3 class="font-black">Hours</h3>
      <p class="mt-2 text-sm text-[#111815]/70">{siteInfo.hoursLabel}</p>
    </div>
    <div class="rounded-lg bg-white p-6 shadow-sm">
      <Icon name="map" class="mb-4 size-7 text-primary" />
      <h3 class="font-black">Location</h3>
      <p class="mt-2 text-sm text-[#111815]/70">{siteInfo.addressLine1}<br />{siteInfo.cityStateZip}</p>
    </div>
    <div class="rounded-lg bg-white p-6 shadow-sm">
      <Icon name="users" class="mb-4 size-7 text-primary" />
      <h3 class="font-black">Age Groups</h3>
      <p class="mt-2 text-sm text-[#111815]/70">{siteInfo.ageGroups.join(', ')}, and school-age care.</p>
    </div>
    <div class="rounded-lg bg-white p-6 shadow-sm">
      <Icon name="sparkles" class="mb-4 size-7 text-primary" />
      <h3 class="font-black">Offerings</h3>
      <p class="mt-2 text-sm text-[#111815]/70">{siteInfo.offerings.join(', ')}.</p>
    </div>
  </section>

  <section class="pb-16">
    <div class="rounded-lg border border-primary/15 bg-primary/5 p-8">
      <h2 class="text-3xl font-black">Details to bring to BBMA</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {[
          'What does a normal day look like for my child\'s age?',
          'How are meals, rest, outdoor play, and parent updates handled?',
          'Which nearby BBMA location works best for my preferred start date?',
          'How does before and after school pickup work?',
        ].map((item) => (
          <p class="flex gap-3 text-[#111815]/80">
            <Icon name="check" class="mt-1 size-5 shrink-0 text-primary" />
            <span>{item}</span>
          </p>
        ))}
      </div>
    </div>
  </section>

  <LeadCTA />
</BaseLayout>
