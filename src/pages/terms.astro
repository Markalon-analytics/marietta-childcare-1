---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { images } from '../data/site';
---

<BaseLayout
  title="Terms | Marietta Childcare"
  description="Terms for comparing nearby BBMA child care locations through Marietta Childcare."
>
  <PageHero
    title="Terms"
    description="Review how location-selection information and BBMA tour links are handled."
    image={images.classroom}
    eyebrow="Site policy"
  />

  <section class="prose prose-lg max-w-3xl py-16">
    <h2>Information use</h2>
    <p>Parents comparing <a data-contextual href="/service-areas/" class="underline underline-offset-2 hover:decoration-2">nearby BBMA options</a> should treat the information here as guidance, not a guarantee of enrollment, open classroom space, <a data-contextual href="/faq/how-much-childcare-cost/" class="underline underline-offset-2 hover:decoration-2">tuition</a>, or specific classroom placement.</p>
    <h2>Tour requests</h2>
    <p>Following a tour or enrollment link starts a conversation with BBMA. Open classroom space, <a data-contextual href="/programs/" class="underline underline-offset-2 hover:decoration-2">age groups</a>, schedule options, and pricing must be confirmed directly before enrollment.</p>
    <h2>Contact</h2>
    <p>Use the official BBMA tour link for current location and enrollment information.</p>
  </section>
</BaseLayout>
