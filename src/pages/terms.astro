---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { images } from '../data/site';
---

<BaseLayout
  title="Terms | Marietta Childcare"
  description="Terms for comparing nearby BBMA child care locations through Marietta Childcare."
>
  <PageHero
    title="Terms"
    description="Review how location-selection information and BBMA tour links are handled."
    image={images.classroom}
    eyebrow="Site policy"
  />

  <section class="prose prose-lg max-w-3xl py-16">
    <h2>Information use</h2>
    <p>Parents comparing nearby BBMA options should treat the information here as guidance, not a guarantee of enrollment, open classroom space, tuition, or specific classroom placement.</p>
    <h2>Tour requests</h2>
    <p>Following a tour or enrollment link starts a conversation with BBMA. Open classroom space, age groups, schedule options, and pricing must be confirmed directly before enrollment.</p>
    <h2>Contact</h2>
    <p>Use the official BBMA tour link for current location and enrollment information.</p>
  </section>
</BaseLayout>
