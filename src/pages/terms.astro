---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { images, siteInfo } from '../data/site';
---

<BaseLayout
  title="Terms | Marietta Childcare"
  description="Terms for using MariettaChildCare.com."
>
  <PageHero
    title="Terms"
    description="This site helps families request child care information and schedule local tour conversations."
    image={images.classroom}
    eyebrow="Site policy"
  />

  <section class="prose prose-lg max-w-3xl py-16">
    <h2>Site use</h2>
    <p>MariettaChildCare.com provides child care information for families comparing local options. Site content is informational and does not guarantee enrollment, availability, tuition, or specific classroom placement.</p>
    <h2>Tour requests</h2>
    <p>Submitting a form starts a conversation. Current openings, age groups, schedule options, and pricing must be confirmed directly with the center.</p>
    <h2>Contact</h2>
    <p>Call <a href={siteInfo.phoneHref}>{siteInfo.phoneLabel}</a> for current information.</p>
  </section>
</BaseLayout>
