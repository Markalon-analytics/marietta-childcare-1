---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SimplePageContent from '../../components/SimplePageContent.astro';
import { programPages } from '../../data/site';

export function getStaticPaths() {
  const serviceAliases = [
    { slug: 'infant-care', page: programPages.find((page) => page.slug === 'infant-care') },
    { slug: 'toddlers', page: programPages.find((page) => page.slug === 'toddler-program') },
    { slug: 'preschool', page: programPages.find((page) => page.slug === 'preschool') },
    { slug: 'after-school', page: programPages.find((page) => page.slug === 'after-school') },
  ].filter((item) => item.page);

  return serviceAliases.map((item) => ({
    params: { slug: item.slug },
    props: { page: item.page, slug: item.slug },
  }));
}

const { page, slug } = Astro.props;
---

<BaseLayout title={page.title} description={page.description} canonical={`/services/${slug}/`}>
  <PageHero title={page.heroTitle} description={page.heroText} image={page.heroImage} eyebrow="Child care service" />
  <SimplePageContent page={page} />
</BaseLayout>
