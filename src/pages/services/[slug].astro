---
import ContentLayout from '../../layouts/ContentLayout.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description, heroImage, ageRange, faq } = entry.data;
---

<BaseLayout
  title={`${title} - Marietta Childcare`}
  description={description}
  canonical={`/services/${entry.slug}/`}
>
  <article class="py-12">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8">
        <span class="inline-block px-4 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest mb-4">
          {ageRange}
        </span>
        <h1 class="text-5xl font-black mb-6">{title}</h1>
        <p class="text-xl text-[#111815]/70 dark:text-white/70 leading-relaxed">
          {description}
        </p>
      </div>

      {heroImage && (
        <img
          src={heroImage}
          alt={title}
          class="w-full h-96 object-cover rounded-xl mb-12 shadow-lg"
        />
      )}

      <div class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-black prose-h2:text-3xl prose-h3:text-2xl prose-p:text-[#111815]/80 dark:prose-p:text-white/80 prose-p:leading-relaxed prose-a:text-primary prose-strong:text-[#111815] dark:prose-strong:text-white">
        <Content />
      </div>

      {faq.length > 0 && (
        <section class="mt-16 pt-16 border-t border-[#f0f4f3] dark:border-white/10">
          <h2 class="text-3xl font-black mb-8">Frequently Asked Questions</h2>
          <dl class="space-y-6">
            {faq.map(({ q, a }) => (
              <div class="bg-white dark:bg-white/5 p-6 rounded-lg border border-[#f0f4f3] dark:border-white/10">
                <dt class="font-bold text-lg mb-2 flex items-start gap-3">
                  <span class="material-symbols-outlined text-primary mt-1">help</span>
                  {q}
                </dt>
                <dd class="text-[#111815]/70 dark:text-white/70 ml-9">{a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <section class="mt-16 bg-gradient-to-br from-primary to-[#0da36a] rounded-lg p-10 text-center text-white">
        <h2 class="text-3xl font-black mb-4">Interested in {title}?</h2>
        <p class="text-white/90 text-lg mb-8 max-w-[500px] mx-auto">
          Schedule a tour to see our {title.toLowerCase()} program in action and meet our dedicated team.
        </p>
        <button class="bg-white text-primary px-10 py-4 rounded-full font-black text-lg hover:scale-105 transition-transform shadow-xl">
          Schedule a Tour
        </button>
      </section>
    </div>
  </article>
</BaseLayout>
