---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';
import PageHero from '../../components/PageHero.astro';
import { faqPages, images } from '../../data/site';
---

<BaseLayout
  title="BBMA Child Care FAQ Near Marietta | Marietta Childcare"
  description="Answers to common Marietta-area BBMA child care questions about hours, enrollment, cost, curriculum, meals, safety, teachers, and kindergarten readiness."
>
  <PageHero
    title="Frequently Asked Questions"
    description="Know what matters before you choose a BBMA location: commute, hours, cost, enrollment, meals, safety, parent updates, and how each classroom supports your child's age."
    image={images.books}
    eyebrow="FAQ"
  />

  <section class="py-16">
    <div class="grid gap-6 md:grid-cols-2">
      {faqPages.map((page) => (
        <a href={`/faq/${page.slug}`} class="rounded-lg border border-[#e4ece8] bg-white p-6 shadow-sm transition hover:border-primary hover:shadow-lg">
          <h2 class="text-xl font-black">{page.heroTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#111815]/70">{page.description}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-primary">
            Read answer <Icon name="arrow" class="size-4" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <LeadCTA title="Still choosing a BBMA location?" text="Share your child&apos;s age, start date, and commute so BBMA can help you find the right school to tour." />
</BaseLayout>
