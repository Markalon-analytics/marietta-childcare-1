---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { images, siteInfo } from '../data/site';
---

<BaseLayout
  title="Schedule a Tour | Marietta Childcare"
  description="Schedule a Marietta child care tour or call about infant care, toddler care, preschool, pre-K, and school-age care."
>
  <PageHero
    title="Schedule a Tour"
    description="Tell us your child's age, your preferred start date, and what your week needs from child care. We will help you see what the day could look like."
    image={images.dropoff}
    eyebrow="Contact"
  />

  <section class="py-16">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <aside class="space-y-6">
        <div class="rounded-lg bg-white p-6 shadow-sm">
          <Icon name="map" class="mb-3 size-6 text-primary" />
          <h2 class="font-black">Location</h2>
          <p class="mt-2 text-[#111815]/70">{siteInfo.addressLine1}<br />{siteInfo.cityStateZip}</p>
        </div>
        <div class="rounded-lg bg-white p-6 shadow-sm">
          <Icon name="phone" class="mb-3 size-6 text-primary" />
          <h2 class="font-black">Phone</h2>
          <a class="mt-2 inline-block text-primary font-bold" href={siteInfo.phoneHref}>{siteInfo.phoneLabel}</a>
        </div>
        <div class="rounded-lg bg-white p-6 shadow-sm">
          <Icon name="clock" class="mb-3 size-6 text-primary" />
          <h2 class="font-black">Hours</h2>
          <p class="mt-2 text-[#111815]/70">{siteInfo.hoursLabel}</p>
        </div>
      </aside>

      <form name="tour-request" method="post" data-netlify="true" class="rounded-lg border border-primary/15 bg-white p-6 shadow-lg md:p-8">
        <input type="hidden" name="form-name" value="tour-request" />
        <h2 class="text-3xl font-black">Tour request</h2>
        <p class="mt-3 text-[#111815]/70">
          Share the basics and anything you want covered. You can also call {siteInfo.phoneLabel}.
        </p>

        <div class="mt-8 grid gap-5 md:grid-cols-2">
          <label class="block font-bold">
            Parent name
            <input name="parent_name" type="text" autocomplete="name" class="mt-2 w-full rounded border border-gray-300 px-4 py-3 font-normal" required />
          </label>
          <label class="block font-bold">
            Phone
            <input name="phone" type="tel" autocomplete="tel" class="mt-2 w-full rounded border border-gray-300 px-4 py-3 font-normal" required />
          </label>
          <label class="block font-bold">
            Email
            <input name="email" type="email" autocomplete="email" class="mt-2 w-full rounded border border-gray-300 px-4 py-3 font-normal" required />
          </label>
          <label class="block font-bold">
            Child's age
            <select name="child_age" class="mt-2 w-full rounded border border-gray-300 px-4 py-3 font-normal" required>
              <option value="">Select age range</option>
              <option>Infant</option>
              <option>Toddler</option>
              <option>Two years old</option>
              <option>Three years old</option>
              <option>Four years old</option>
              <option>School-age</option>
            </select>
          </label>
          <label class="block font-bold md:col-span-2">
            Preferred start date or timing
            <input name="start_timing" type="text" placeholder="Example: August, next month, or as soon as possible" class="mt-2 w-full rounded border border-gray-300 px-4 py-3 font-normal" />
          </label>
          <label class="block font-bold md:col-span-2">
            What should we know?
            <textarea name="message" class="mt-2 h-32 w-full rounded border border-gray-300 px-4 py-3 font-normal" placeholder="Tell us about schedule, tuition, allergies, school pickup, meals, or anything else you want covered on the tour."></textarea>
          </label>
        </div>

        <button type="submit" class="mt-7 w-full rounded-full bg-primary px-8 py-4 font-black text-white transition hover:bg-primary/90">
          Send Tour Request
        </button>
      </form>
    </div>
  </section>

  <section class="pb-16">
    <div class="rounded-lg bg-[#10221b] p-8 text-white">
      <h2 class="text-3xl font-black">What to cover during the tour</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <p class="text-white/80">See how the daily schedule changes for infants, toddlers, preschoolers, and school-age children.</p>
        <p class="text-white/80">Cover parent updates, pickup authorization, meals, rest, and sick-child rules.</p>
        <p class="text-white/80">Bring your child's age and start date so open classroom space can be discussed directly.</p>
      </div>
    </div>
  </section>
</BaseLayout>
