---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Programs - Marietta Childcare"
  description="Explore Marietta Childcare's comprehensive childcare programs for infants through school-age children.">
  <section class="relative py-32 overflow-hidden w-screen -ml-[calc((100vw-100%)/2)]">
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/Background_Images/diverse_children_sharing_toy_background.jpg" 
        alt="Childcare programs" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-black/40"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-6 lg:px-20">
      <h1 class="text-4xl lg:text-6xl font-black mb-6 text-white drop-shadow-lg">Childcare Programs</h1>
      <p class="text-lg mb-12 max-w-2xl text-white drop-shadow-md">Comprehensive programs for every age and stage of development with play-based, developmentally appropriate activities.</p>
    </div>
  </section>

  <section class="py-20 px-6 lg:px-20">
    <div class="max-w-[1280px] mx-auto">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <a href="/programs/infant-care" class="bg-white border-2 border-primary/20 hover:border-primary p-6 rounded-lg transition-all hover:shadow-lg">
          <h3 class="text-xl font-bold mb-2">Infant Care Program</h3>
          <p class="text-sm mb-4">Newborns to 12 months with personalized care and developmental support</p>
          <span class="text-primary font-bold">Learn More →</span>
        </a>

        <a href="/programs/toddler-program" class="bg-white border-2 border-secondary/20 hover:border-secondary p-6 rounded-lg transition-all hover:shadow-lg">
          <h3 class="text-xl font-bold mb-2">Toddler Program</h3>
          <p class="text-sm mb-4">Ages 12-36 months with language development and social skills focus</p>
          <span class="text-secondary font-bold">Learn More →</span>
        </a>

        <a href="/programs/preschool" class="bg-white border-2 border-primary/20 hover:border-primary p-6 rounded-lg transition-all hover:shadow-lg">
          <h3 class="text-xl font-bold mb-2">Preschool Program</h3>
          <p class="text-sm mb-4">Ages 3-5 with pre-K preparation and creative learning experiences</p>
          <span class="text-primary font-bold">Learn More →</span>
        </a>

        <a href="/programs/pre-k" class="bg-white border-2 border-secondary/20 hover:border-secondary p-6 rounded-lg transition-all hover:shadow-lg">
          <h3 class="text-xl font-bold mb-2">Pre-Kindergarten</h3>
          <p class="text-sm mb-4">Ages 4-5 with kindergarten readiness and academic skill development</p>
          <span class="text-secondary font-bold">Learn More →</span>
        </a>

        <a href="/programs/after-school" class="bg-white border-2 border-primary/20 hover:border-primary p-6 rounded-lg transition-all hover:shadow-lg">
          <h3 class="text-xl font-bold mb-2">After-School Program</h3>
          <p class="text-sm mb-4">School-age children with homework support and enrichment activities</p>
          <span class="text-primary font-bold">Learn More →</span>
        </a>

        <a href="/programs/summer-camp" class="bg-white border-2 border-secondary/20 hover:border-secondary p-6 rounded-lg transition-all hover:shadow-lg">
          <h3 class="text-xl font-bold mb-2">Summer Camp Program</h3>
          <p class="text-sm mb-4">Full-day summer activities with field trips and STEM learning</p>
          <span class="text-secondary font-bold">Learn More →</span>
        </a>
      </div>

      <div class="bg-gradient-to-r from-primary/10 to-secondary/10 p-8 rounded-lg mb-12">
        <h2 class="text-2xl font-bold mb-4">Flexible Care Options</h2>
        <p class="mb-6">Marietta Childcare understands that families have different needs. Marietta Childcare offers flexible scheduling options including full-time care, part-time enrollment, drop-in care, and school break programs.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a href="/programs/full-time-care" class="text-primary font-bold hover:underline">Full-Time Care →</a>
          <a href="/programs/part-time-care" class="text-primary font-bold hover:underline">Part-Time Options →</a>
          <a href="/programs/school-break-care" class="text-primary font-bold hover:underline">School Break Care →</a>
        </div>
      </div>

      <div class="bg-gradient-to-r from-secondary/10 to-primary/10 p-8 rounded-lg text-center">
        <h2 class="text-2xl font-bold mb-4">Special Needs Support</h2>
        <p class="mb-6">Marietta Childcare is committed to inclusive care for all children. Marietta Childcare provides individualized attention and specialized support services for children with special needs.</p>
        <a href="/programs/special-needs" class="inline-block bg-secondary text-white px-8 py-3 rounded-full font-bold hover:scale-105 transition-transform">
          Learn About Special Needs Support
        </a>
      </div>
    </div>
  </section>
</Layout>
