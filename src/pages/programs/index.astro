---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';
import PageHero from '../../components/PageHero.astro';
import { images, programPages } from '../../data/site';
---

<BaseLayout
  title="BBMA Child Care Programs Near Marietta | Marietta Childcare"
  description="Compare Big Blue Marble Academy programs near Marietta for infants, toddlers, preschoolers, pre-K children, school-age care, summer care, and flexible schedules."
>
  <PageHero
    title="BBMA Child Care Programs"
    description="Start with your child's age and your family's schedule. Then choose the BBMA location where classroom fit, daily routines, communication, and open space make sense."
    image={images.play}
    eyebrow="Programs"
  />

  <section class="py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {programPages.map((page) => (
        <a href={`/programs/${page.slug}`} class="group rounded-lg border border-[#e4ece8] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
          <div class="mb-5 h-40 overflow-hidden rounded-lg">
            <img src={page.heroImage} alt="" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
          </div>
          <h2 class="text-2xl font-black">{page.heroTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#111815]/70">{page.description}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-primary">
            Learn more <Icon name="arrow" class="size-4" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <LeadCTA />
</BaseLayout>
