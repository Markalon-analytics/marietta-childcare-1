---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LeadCTA from '../components/LeadCTA.astro';
import PageHero from '../components/PageHero.astro';
import { images, resourcePages } from '../data/site';
---

<BaseLayout
  title="Parent Resources | Marietta Childcare"
  description="Parent resources for choosing child care, child development, meals and snacks, school readiness, and easier classroom transitions."
>
  <PageHero
    title="Parent Resources"
    description="Use these practical guides to compare child care, prepare for a new classroom, and know what to cover on your tour."
    image={images.dropoff}
    eyebrow="Resources"
  />

  <section class="py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {resourcePages.map((page) => (
        <a href={`/resources/${page.slug}`} class="rounded-lg border border-[#e4ece8] bg-white p-6 shadow-sm transition hover:border-primary hover:shadow-lg">
          <Icon name="book" class="mb-4 size-7 text-primary" />
          <h2 class="text-xl font-black">{page.heroTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#111815]/70">{page.description}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-primary">
            Read guide <Icon name="arrow" class="size-4" />
          </span>
        </a>
      ))}
      <a href="/faq" class="rounded-lg border border-[#e4ece8] bg-white p-6 shadow-sm transition hover:border-primary hover:shadow-lg">
        <Icon name="sparkles" class="mb-4 size-7 text-primary" />
        <h2 class="text-xl font-black">Questions before you enroll</h2>
        <p class="mt-3 text-sm leading-relaxed text-[#111815]/70">Hours, tuition, safety, meals, teachers, and parent communication should all make sense before you choose care.</p>
        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-primary">
          See FAQ <Icon name="arrow" class="size-4" />
        </span>
      </a>
    </div>
  </section>

  <LeadCTA />
</BaseLayout>
