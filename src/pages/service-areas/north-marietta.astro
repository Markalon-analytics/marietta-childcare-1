---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "North Marietta Childcare | Marietta Childcare";
const description = "Quality childcare in north Marietta neighborhoods. Local expertise and family-focused care for northern communities.";
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen">
    <section class="bg-gradient-to-r from-green-50 to-emerald-50 py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">North Marietta Childcare</h1>
        <p class="text-xl text-gray-700 mb-6">
          North Marietta Childcare serves families in northern neighborhoods. North Marietta area includes residential communities and family-oriented neighborhoods. North Marietta location provides convenient access to northern families seeking quality childcare.
        </p>
        <a href="/contact" class="inline-block bg-green-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-700">Schedule a Tour</a>
      </div>
    </section>

    <section class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Serving North Marietta Families</h2>
          <p class="text-gray-700 mb-4">
            North Marietta Childcare understands the needs of families in northern neighborhoods. North Marietta families benefit from our convenient location and community-focused approach. North Marietta area includes established residential communities with strong family networks.
          </p>
          <p class="text-gray-700 mb-6">
            Local Expertise in North Marietta enables Marietta Childcare to connect families with neighborhood resources and community services. Local Expertise supports families by providing information about schools, parks, and family activities in the north Marietta area.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">North Marietta Community</h2>
          <p class="text-gray-700 mb-4">
            North Marietta Community includes families seeking quality childcare in family-oriented neighborhoods. North Marietta neighborhoods feature residential areas with parks, schools, and community centers. North Marietta location provides access to family-friendly amenities and services.
          </p>
          <p class="text-gray-700 mb-6">
            Community Connection at Marietta Childcare means we're invested in North Marietta. Community Connection includes partnerships with local schools, participation in neighborhood events, and support for family-oriented initiatives.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Why Choose North Marietta Childcare</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-green-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Neighborhood Focus</h3>
              <p class="text-gray-700">Deep understanding of North Marietta neighborhoods and family needs.</p>
            </div>
            <div class="bg-green-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Family Community</h3>
              <p class="text-gray-700">Strong connections with family-oriented community and local networks.</p>
            </div>
            <div class="bg-green-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">School Partnerships</h3>
              <p class="text-gray-700">Partnerships with North Marietta schools support school readiness.</p>
            </div>
            <div class="bg-green-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Local Resources</h3>
              <p class="text-gray-700">Knowledge of neighborhood parks, activities, and family services.</p>
            </div>
          </div>
        </div>

        <div class="bg-green-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Experience North Marietta Childcare</h2>
          <p class="text-gray-700 mb-6">
            Marietta Childcare's North Marietta location serves families in northern neighborhoods. Our educators understand North Marietta community and provide quality care that supports child development.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="inline-block bg-green-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-700">Schedule a Tour</a>
            <a href="/service-areas" class="inline-block bg-white text-green-600 px-6 py-3 rounded-lg font-semibold border-2 border-green-600 hover:bg-green-50">View All Service Areas</a>
          </div>
        </div>

      </div>
    </section>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Marietta Childcare - North Marietta",
      "areaServed": "North Marietta, Georgia"
    }
    </script>
  </div>
</BaseLayout>
