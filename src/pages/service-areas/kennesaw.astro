---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Kennesaw Childcare | Marietta Childcare";
const description = "Quality childcare in Kennesaw with local market focus and community project involvement.";
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen bg-white">
    <section class="bg-gradient-to-r from-cyan-50 to-blue-50 py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Kennesaw Childcare</h1>
        <p class="text-xl text-gray-700 mb-6">
          Kennesaw Childcare serves families in nearby Kennesaw. Kennesaw location provides access to families in this growing community. Kennesaw families benefit from Marietta Childcare's local expertise and community involvement.
        </p>
        <a href="/contact" class="inline-block bg-cyan-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-cyan-700">Schedule a Tour</a>
      </div>
    </section>

    <section class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Serving Kennesaw Families</h2>
          <p class="text-gray-700 mb-4">
            Kennesaw Childcare serves families in this growing community. Kennesaw families benefit from our local market focus and quality care. Kennesaw area includes growing residential communities and family-oriented neighborhoods.
          </p>
          <p class="text-gray-700 mb-6">
            Local Expertise in Kennesaw enables Marietta Childcare to serve families and connect them with community resources. Local Expertise supports families by providing information about Kennesaw schools, parks, and community services.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Kennesaw Community</h2>
          <p class="text-gray-700 mb-4">
            Kennesaw Community includes families seeking quality childcare in a growing area. Kennesaw neighborhoods feature residential areas with strong community focus. Kennesaw location provides access to community services and family activities.
          </p>
          <p class="text-gray-700 mb-6">
            Community Connection at Marietta Childcare means we're invested in Kennesaw. Community Connection includes participation in community projects, partnerships with local organizations, and support for Kennesaw families.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Why Choose Kennesaw Childcare</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-cyan-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Local Market Focus</h3>
              <p class="text-gray-700">Deep understanding of Kennesaw market and community needs.</p>
            </div>
            <div class="bg-cyan-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Community Projects</h3>
              <p class="text-gray-700">Active involvement in Kennesaw community initiatives.</p>
            </div>
            <div class="bg-cyan-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Growing Community</h3>
              <p class="text-gray-700">Serving Kennesaw's growing families and neighborhoods.</p>
            </div>
            <div class="bg-cyan-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Quality Care</h3>
              <p class="text-gray-700">Consistent quality childcare for Kennesaw families.</p>
            </div>
          </div>
        </div>

        <div class="bg-cyan-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Experience Kennesaw Childcare</h2>
          <p class="text-gray-700 mb-6">
            Marietta Childcare's Kennesaw location serves families in this growing community. Our educators provide quality care with local market focus and community commitment.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="inline-block bg-cyan-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-cyan-700">Schedule a Tour</a>
            <a href="/service-areas" class="inline-block bg-white text-cyan-600 px-6 py-3 rounded-lg font-semibold border-2 border-cyan-600 hover:bg-cyan-50">View All Service Areas</a>
          </div>
        </div>

      </div>
    </section>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Marietta Childcare - Kennesaw",
      "areaServed": "Kennesaw, Georgia"
    }
    </script>
  </main>
</BaseLayout>
