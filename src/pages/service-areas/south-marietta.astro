---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "South Marietta Childcare | Marietta Childcare";
const description = "Quality childcare in south Marietta. Serving diverse families with local expertise and community focus.";
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen">
    <section class="bg-gradient-to-r from-orange-50 to-amber-50 py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">South Marietta Childcare</h1>
        <p class="text-xl text-gray-700 mb-6">
          South Marietta Childcare serves families in southern neighborhoods. South Marietta area includes diverse residential communities. South Marietta location provides convenient access to southern families seeking quality childcare.
        </p>
        <a href="/contact" class="inline-block bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-orange-700">Schedule a Tour</a>
      </div>
    </section>

    <section class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Serving South Marietta Families</h2>
          <p class="text-gray-700 mb-4">
            South Marietta Childcare understands the needs of families in southern neighborhoods. South Marietta families benefit from our convenient location and commitment to quality care. South Marietta area includes diverse communities with rich cultural traditions.
          </p>
          <p class="text-gray-700 mb-6">
            Local Expertise in South Marietta enables Marietta Childcare to serve diverse families and connect them with community resources. Local Expertise supports families by providing culturally responsive care and information about neighborhood services.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">South Marietta Community</h2>
          <p class="text-gray-700 mb-4">
            South Marietta Community includes diverse families seeking quality childcare. South Marietta neighborhoods feature residential areas with strong community connections. South Marietta location provides access to community services and cultural resources.
          </p>
          <p class="text-gray-700 mb-6">
            Community Connection at Marietta Childcare means we're invested in South Marietta. Community Connection includes partnerships with community organizations, participation in neighborhood events, and support for diverse families.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Why Choose South Marietta Childcare</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-orange-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Culturally Responsive</h3>
              <p class="text-gray-700">Commitment to serving diverse families with cultural sensitivity and respect.</p>
            </div>
            <div class="bg-orange-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Community Partnerships</h3>
              <p class="text-gray-700">Strong partnerships with South Marietta community organizations.</p>
            </div>
            <div class="bg-orange-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Local Knowledge</h3>
              <p class="text-gray-700">Deep understanding of South Marietta neighborhoods and resources.</p>
            </div>
            <div class="bg-orange-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Family Support</h3>
              <p class="text-gray-700">Comprehensive support for families in South Marietta area.</p>
            </div>
          </div>
        </div>

        <div class="bg-orange-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Experience South Marietta Childcare</h2>
          <p class="text-gray-700 mb-6">
            Marietta Childcare's South Marietta location serves diverse families in southern neighborhoods. Our educators provide culturally responsive care that supports child development.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="inline-block bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-orange-700">Schedule a Tour</a>
            <a href="/service-areas" class="inline-block bg-white text-orange-600 px-6 py-3 rounded-lg font-semibold border-2 border-orange-600 hover:bg-orange-50">View All Service Areas</a>
          </div>
        </div>

      </div>
    </section>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Marietta Childcare - South Marietta",
      "areaServed": "South Marietta, Georgia"
    }
    </script>
  </div>
</BaseLayout>
