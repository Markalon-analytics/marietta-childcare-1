---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "West Marietta Childcare | Marietta Childcare";
const description = "Quality childcare on the west side of Marietta. Neighborhood profiles and local focus for west Marietta families.";
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen">
    <section class="bg-gradient-to-r from-purple-50 to-pink-50 py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">West Marietta Childcare</h1>
        <p class="text-xl text-gray-700 mb-6">
          West Marietta Childcare serves families on the west side. West Marietta area includes residential neighborhoods. West Marietta location provides convenient access to western families seeking quality childcare.
        </p>
        <a href="/contact" class="inline-block bg-purple-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-purple-700">Schedule a Tour</a>
      </div>
    </section>

    <section class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Serving West Marietta Families</h2>
          <p class="text-gray-700 mb-4">
            West Marietta Childcare understands the needs of families on the west side. West Marietta families benefit from our convenient location and quality care. West Marietta area includes residential neighborhoods with family-oriented communities.
          </p>
          <p class="text-gray-700 mb-6">
            Local Expertise in West Marietta enables Marietta Childcare to serve families and connect them with neighborhood resources. Local Expertise supports families by providing information about schools, parks, and services in the west Marietta area.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">West Marietta Community</h2>
          <p class="text-gray-700 mb-4">
            West Marietta Community includes families seeking quality childcare in residential neighborhoods. West Marietta neighborhoods feature family-oriented areas with community amenities. West Marietta location provides access to neighborhood services and activities.
          </p>
          <p class="text-gray-700 mb-6">
            Community Connection at Marietta Childcare means we're invested in West Marietta. Community Connection includes partnerships with local organizations, participation in neighborhood events, and support for west side families.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Why Choose West Marietta Childcare</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Neighborhood Focus</h3>
              <p class="text-gray-700">Deep understanding of West Marietta neighborhoods and families.</p>
            </div>
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Local Knowledge</h3>
              <p class="text-gray-700">Comprehensive knowledge of West Marietta community resources.</p>
            </div>
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Family Community</h3>
              <p class="text-gray-700">Strong connections with West Marietta family networks.</p>
            </div>
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Quality Care</h3>
              <p class="text-gray-700">Consistent quality childcare for West Marietta families.</p>
            </div>
          </div>
        </div>

        <div class="bg-purple-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Experience West Marietta Childcare</h2>
          <p class="text-gray-700 mb-6">
            Marietta Childcare's West Marietta location serves families on the west side. Our educators provide quality care with neighborhood focus and community commitment.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="inline-block bg-purple-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-purple-700">Schedule a Tour</a>
            <a href="/service-areas" class="inline-block bg-white text-purple-600 px-6 py-3 rounded-lg font-semibold border-2 border-purple-600 hover:bg-purple-50">View All Service Areas</a>
          </div>
        </div>

      </div>
    </section>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Marietta Childcare - West Marietta",
      "areaServed": "West Marietta, Georgia"
    }
    </script>
  </div>
</BaseLayout>
