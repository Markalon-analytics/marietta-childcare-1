---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "East Marietta Childcare | Marietta Childcare";
const description = "Quality childcare on the east side of Marietta. Local expertise and family testimonials from east Marietta families.";
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen">
    <section class="bg-gradient-to-r from-red-50 to-rose-50 py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">East Marietta Childcare</h1>
        <p class="text-xl text-gray-700 mb-6">
          East Marietta Childcare serves families on the east side. East Marietta area includes established neighborhoods and growing communities. East Marietta location provides convenient access to eastern families seeking quality childcare.
        </p>
        <a href="/contact" class="inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700">Schedule a Tour</a>
      </div>
    </section>

    <section class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Serving East Marietta Families</h2>
          <p class="text-gray-700 mb-4">
            East Marietta Childcare understands the needs of families on the east side. East Marietta families benefit from our convenient location and quality care. East Marietta area includes established neighborhoods with strong family communities.
          </p>
          <p class="text-gray-700 mb-6">
            Local Expertise in East Marietta enables Marietta Childcare to serve families and connect them with neighborhood resources. Local Expertise supports families by providing information about schools, parks, and services in the east Marietta area.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">East Marietta Community</h2>
          <p class="text-gray-700 mb-4">
            East Marietta Community includes families seeking quality childcare in established neighborhoods. East Marietta neighborhoods feature residential areas with community amenities. East Marietta location provides access to family-friendly services and activities.
          </p>
          <p class="text-gray-700 mb-6">
            Community Connection at Marietta Childcare means we're invested in East Marietta. Community Connection includes partnerships with local schools, participation in neighborhood events, and support for east side families.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Why Choose East Marietta Childcare</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-red-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Established Presence</h3>
              <p class="text-gray-700">Long-standing commitment to serving East Marietta families.</p>
            </div>
            <div class="bg-red-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Local Expertise</h3>
              <p class="text-gray-700">Deep knowledge of East Marietta neighborhoods and community.</p>
            </div>
            <div class="bg-red-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Family Testimonials</h3>
              <p class="text-gray-700">Trusted by families throughout East Marietta area.</p>
            </div>
            <div class="bg-red-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Community Involvement</h3>
              <p class="text-gray-700">Active participation in East Marietta community events.</p>
            </div>
          </div>
        </div>

        <div class="bg-red-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Experience East Marietta Childcare</h2>
          <p class="text-gray-700 mb-6">
            Marietta Childcare's East Marietta location serves families on the east side. Our educators provide quality care grounded in local expertise and community knowledge.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700">Schedule a Tour</a>
            <a href="/service-areas" class="inline-block bg-white text-red-600 px-6 py-3 rounded-lg font-semibold border-2 border-red-600 hover:bg-red-50">View All Service Areas</a>
          </div>
        </div>

      </div>
    </section>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Marietta Childcare - East Marietta",
      "areaServed": "East Marietta, Georgia"
    }
    </script>
  </div>
</BaseLayout>
