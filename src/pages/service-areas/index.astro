---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';
import PageHero from '../../components/PageHero.astro';
import { bbmaLocations, images, serviceAreaPages, siteInfo } from '../../data/site';

const areaSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Marietta Childcare',
  url: 'https://marietta-childcare.com/service-areas/',
  about: 'BBMA child care location selection near Marietta, Georgia',
};
---

<BaseLayout
  title="BBMA Locations Near Marietta | Marietta Childcare"
  description="Compare nearby Big Blue Marble Academy locations around Marietta, Cobb County, Woodstock, Powder Springs, Acworth, Dallas, and Dunwoody."
>
  <PageHero
    title="BBMA Locations Near Marietta"
    description="Choose the Big Blue Marble Academy location that fits your commute, school pickup needs, child care hours, and start date."
    image={images.play}
    eyebrow="Service areas"
  />

  <section class="py-16">
    <div class="mb-10 max-w-3xl">
      <h2 class="text-4xl font-black">Start with the real address.</h2>
      <p class="mt-4 text-lg leading-relaxed text-[#111815]/75">
        The practical question is not just whether a location is near Marietta. It is whether a BBMA address works for your morning drive, your pickup window, and the age group your child needs now.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {serviceAreaPages.map((page) => (
        <a href={`/service-areas/${page.slug}`} class="rounded-lg border border-[#e4ece8] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
          <Icon name="map" class="mb-4 size-7 text-primary" />
          <h2 class="text-xl font-black">{page.heroTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#111815]/70">{page.description}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-primary">
            View area <Icon name="arrow" class="size-4" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="pb-16">
    <div class="rounded-lg bg-white p-8 shadow-sm">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-black">Nearby BBMA location options</h2>
        <p class="mt-3 text-[#111815]/70">
          These are the BBMA locations returned by the official Marietta search. Use the list to compare distance, address, and which school details you want to review before scheduling.
        </p>
      </div>
      <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {bbmaLocations.map((location) => (
          <a href={location.href} class="rounded-lg border border-[#e4ece8] p-5 transition hover:-translate-y-1 hover:shadow-md">
            <div class="flex items-center justify-between gap-3">
              <Icon name="map" class="size-6 shrink-0 text-primary" />
              <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary">{location.distance}</span>
            </div>
            <h3 class="mt-3 text-lg font-black">{location.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#111815]/70">{location.addressLine1}<br />{location.cityStateZip}</p>
            <p class="mt-3 text-sm font-bold text-primary">{location.phoneLabel}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LeadCTA />

  <script type="application/ld+json" set:html={JSON.stringify(areaSchema)} />
</BaseLayout>
