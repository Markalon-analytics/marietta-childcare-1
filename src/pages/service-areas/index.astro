---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';
import PageHero from '../../components/PageHero.astro';
import { images, serviceAreaPages, siteInfo } from '../../data/site';

const areaSchema = {
  '@context': 'https://schema.org',
  '@type': 'ChildCare',
  name: 'Marietta Childcare',
  telephone: siteInfo.phoneLabel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteInfo.addressLine1,
    addressLocality: 'Marietta',
    addressRegion: 'GA',
    postalCode: '30008',
    addressCountry: 'US',
  },
  areaServed: ['Marietta', 'Kennesaw', 'Smyrna', 'Cobb County'],
};
---

<BaseLayout
  title="Marietta Child Care Service Areas | Marietta Childcare"
  description="Child care service-area information for Marietta, Cobb County, Kennesaw, Smyrna, and nearby families comparing a Marietta center."
>
  <PageHero
    title="Child Care Near Marietta and Cobb County"
    description="The center is located at 2040 MacLand Crossing Circle in Marietta. Use these area pages to compare commute, school pickup, and program fit."
    image={images.play}
    eyebrow="Service areas"
  />

  <section class="py-16">
    <div class="mb-10 max-w-3xl">
      <h2 class="text-4xl font-black">Start with the real address.</h2>
      <p class="mt-4 text-lg leading-relaxed text-[#111815]/75">
        A service-area page should not make the location vague. The practical question is whether the Marietta center works for your route, school pickup, child care hours, and start date.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {serviceAreaPages.map((page) => (
        <a href={`/service-areas/${page.slug}`} class="rounded-lg border border-[#e4ece8] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
          <Icon name="map" class="mb-4 size-7 text-primary" />
          <h2 class="text-xl font-black">{page.heroTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#111815]/70">{page.description}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-primary">
            View area <Icon name="arrow" class="size-4" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="pb-16">
    <div class="rounded-lg bg-white p-8 shadow-sm">
      <h2 class="text-3xl font-black">Local facts</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <p class="flex gap-3 text-[#111815]/75"><Icon name="map" class="mt-1 size-5 shrink-0 text-primary" /> {siteInfo.addressLine1}, {siteInfo.cityStateZip}</p>
        <p class="flex gap-3 text-[#111815]/75"><Icon name="clock" class="mt-1 size-5 shrink-0 text-primary" /> {siteInfo.hoursLabel}</p>
        <p class="flex gap-3 text-[#111815]/75"><Icon name="phone" class="mt-1 size-5 shrink-0 text-primary" /> <a href={siteInfo.phoneHref} class="font-bold text-primary">{siteInfo.phoneLabel}</a></p>
      </div>
    </div>
  </section>

  <LeadCTA />

  <script type="application/ld+json" set:html={JSON.stringify(areaSchema)} />
</BaseLayout>
