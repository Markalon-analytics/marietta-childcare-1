---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Smyrna Childcare | Marietta Childcare";
const description = "Quality childcare in Smyrna with local expertise and family testimonials from Smyrna area.";
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen">
    <section class="bg-gradient-to-r from-teal-50 to-cyan-50 py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Smyrna Childcare</h1>
        <p class="text-xl text-gray-700 mb-6">
          Smyrna Childcare serves families in surrounding Smyrna. Smyrna location provides access to families in this community. Smyrna families benefit from Marietta Childcare's local expertise and family testimonials.
        </p>
        <a href="/contact" class="inline-block bg-teal-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-teal-700">Schedule a Tour</a>
      </div>
    </section>

    <section class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Serving Smyrna Families</h2>
          <p class="text-gray-700 mb-4">
            Smyrna Childcare serves families in the surrounding Smyrna area. Smyrna families benefit from our local expertise and quality care. Smyrna area includes residential communities with family-oriented neighborhoods.
          </p>
          <p class="text-gray-700 mb-6">
            Local Expertise in Smyrna enables Marietta Childcare to serve families and connect them with community resources. Local Expertise supports families by providing information about Smyrna schools, parks, and community services.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Smyrna Community</h2>
          <p class="text-gray-700 mb-4">
            Smyrna Community includes families seeking quality childcare in the surrounding area. Smyrna neighborhoods feature residential areas with community focus. Smyrna location provides access to community services and family activities.
          </p>
          <p class="text-gray-700 mb-6">
            Community Connection at Marietta Childcare means we're invested in Smyrna. Community Connection includes partnerships with local organizations, participation in community events, and support for Smyrna families.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Why Choose Smyrna Childcare</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-teal-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Local Expertise</h3>
              <p class="text-gray-700">Deep knowledge of Smyrna community and family needs.</p>
            </div>
            <div class="bg-teal-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Family Testimonials</h3>
              <p class="text-gray-700">Trusted by families throughout Smyrna area.</p>
            </div>
            <div class="bg-teal-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Community Partnerships</h3>
              <p class="text-gray-700">Strong partnerships with Smyrna organizations.</p>
            </div>
            <div class="bg-teal-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Quality Care</h3>
              <p class="text-gray-700">Consistent quality childcare for Smyrna families.</p>
            </div>
          </div>
        </div>

        <div class="bg-teal-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Experience Smyrna Childcare</h2>
          <p class="text-gray-700 mb-6">
            Marietta Childcare's Smyrna location serves families in the surrounding area. Our educators provide quality care with local expertise and community commitment.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="inline-block bg-teal-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-teal-700">Schedule a Tour</a>
            <a href="/service-areas" class="inline-block bg-white text-teal-600 px-6 py-3 rounded-lg font-semibold border-2 border-teal-600 hover:bg-teal-50">View All Service Areas</a>
          </div>
        </div>

      </div>
    </section>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Marietta Childcare - Smyrna",
      "areaServed": "Smyrna, Georgia"
    }
    </script>
  </div>
</BaseLayout>
