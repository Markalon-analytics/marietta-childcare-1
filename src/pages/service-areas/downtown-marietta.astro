---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Downtown Marietta Childcare | Marietta Childcare";
const description = "Quality childcare in downtown Marietta for families in the heart of the city. Local expertise and community focus.";
---

<BaseLayout title={title} description={description}>
  <section class="py-20 px-6 lg:px-20">
    <div class="max-w-[1280px] mx-auto">
      <h1 class="text-4xl lg:text-5xl font-black mb-6">Downtown Marietta Childcare</h1>
      <p class="text-lg mb-12 max-w-2xl">
          Downtown Marietta Childcare serves families in the heart of Marietta with convenient access for downtown professionals and families. Downtown Marietta community includes vibrant commercial districts and established residential areas.
      </p>
      <a href="/contact" class="inline-block bg-primary text-white px-8 py-3 rounded-full font-bold hover:scale-105 transition-transform">Schedule a Tour</a>
    </div>
  </section>

  <section class="py-20 px-6 lg:px-20">
    <div class="max-w-[1280px] mx-auto">
        
      <div class="prose prose-lg max-w-3xl mb-12">
        <h2>Serving Downtown Marietta Families</h2>
        <p>
            Downtown Marietta Childcare understands the unique needs of families living and working in downtown. Downtown Marietta professionals benefit from convenient location and flexible scheduling. Downtown Marietta families appreciate community connections and local expertise.
          </p>
          <p>
            Local Expertise in Downtown Marietta enables Marietta Childcare to connect families with neighborhood resources and community events. Local Expertise supports families with location-specific information about schools and family services.
        </p>
        <h2>Downtown Marietta Community</h2>
        <p>
            Downtown Marietta Community includes diverse families, young professionals, and established residents. Downtown Marietta neighborhoods feature historic homes and vibrant commercial areas with access to parks and community services.
          </p>
          <p>
            Community Connection at Marietta Childcare means investment in Downtown Marietta. Community Connection includes participation in downtown events and partnerships with local organizations.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <div class="bg-primary/5 p-6 rounded-lg">
          <h3 class="font-bold text-lg mb-4">Why Choose Downtown Marietta</h3>
          <ul class="space-y-2 text-sm">
            <li>✓ Convenient location</li>
            <li>✓ Flexible scheduling</li>
            <li>✓ Local expertise</li>
            <li>✓ Community involvement</li>
            <li>✓ Quality education</li>
            <li>✓ Safe environment</li>
          </ul>
        </div>

        <div class="bg-secondary/5 p-6 rounded-lg">
          <h3 class="font-bold text-lg mb-4">Service Details</h3>
          <ul class="space-y-2 text-sm">
            <li>✓ All age groups</li>
            <li>✓ Full-time programs</li>
            <li>✓ Part-time options</li>
            <li>✓ Extended hours</li>
            <li>✓ Flexible enrollment</li>
            <li>✓ Community focused</li>
          </ul>
        </div>
      </div>

      <div class="bg-gradient-to-r from-primary/10 to-secondary/10 p-8 rounded-lg text-center">
        <h2 class="text-2xl font-bold mb-4">Experience Downtown Marietta Childcare</h2>
        <p class="mb-6">
            Marietta Childcare's Downtown Marietta location serves families in the heart of the city with quality care supporting child development.
        </p>
        <a href="/contact" class="inline-block bg-primary text-white px-8 py-3 rounded-full font-bold hover:scale-105 transition-transform">
          Schedule a Tour
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
