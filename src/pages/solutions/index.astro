---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';
import PageHero from '../../components/PageHero.astro';
import { images, solutionPages } from '../../data/site';
---

<BaseLayout
  title="BBMA Location Help for Marietta Parents | Marietta Childcare"
  description="Guidance for Marietta-area parents choosing a BBMA location for working schedules, first-time enrollment, budget questions, summer care, and school transitions."
>
  <PageHero
    title="Choose a BBMA Location Around Real Schedules"
    description="Your situation changes what matters first: commute, hours, cost, school pickup, summer care, first-time enrollment, and extra support."
    image={images.dropoff}
    eyebrow="Family needs"
  />

  <section class="py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {solutionPages.map((page) => (
        <a href={`/solutions/${page.slug}`} class="rounded-lg border border-[#e4ece8] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
          <Icon name="heart" class="mb-4 size-7 text-primary" />
          <h2 class="text-xl font-black">{page.heroTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#111815]/70">{page.description}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-primary">
            Read more <Icon name="arrow" class="size-4" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <LeadCTA />
</BaseLayout>
