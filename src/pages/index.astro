---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTASection from '../components/CTASection.astro';

const testimonials = [
  {
    name: 'Sarah Jenkins',
    role: 'Mother of 4-year-old',
    testimonial: 'The teachers here are truly remarkable. My daughter has grown so much in her social skills and curiosity!',
    imageUrl: 'https://images.pexels.com/photos/774909/pexels-photo-774909.jpeg?auto=compress&cs=tinysrgb&w=200',
  },
  {
    name: 'David Thompson',
    role: 'Father of 2',
    testimonial: 'A safe and nurturing environment that feels like a second home. We couldn\'t ask for a better community.',
    imageUrl: 'https://images.pexels.com/photos/220453/pexels-photo-220453.jpeg?auto=compress&cs=tinysrgb&w=200',
  },
  {
    name: 'Elena Rodriguez',
    role: 'Mother of twins',
    testimonial: 'The play-based curriculum is exactly what we were looking for. Fantastic facility and professional staff.',
    imageUrl: 'https://images.pexels.com/photos/1181690/pexels-photo-1181690.jpeg?auto=compress&cs=tinysrgb&w=200',
  },
];

const programs = [
  {
    title: 'Infant Care',
    ageRange: '6 Weeks - 12 Months',
    description: 'Providing gentle care and sensory exploration in a safe haven.',
    imageUrl: 'https://images.pexels.com/photos/1912868/pexels-photo-1912868.jpeg?auto=compress&cs=tinysrgb&w=600',
    href: '/services/infant-care',
  },
  {
    title: 'Toddlers',
    ageRange: '1 - 2 Years',
    description: 'Focusing on social skills, language development, and active play.',
    imageUrl: 'https://images.pexels.com/photos/1620653/pexels-photo-1620653.jpeg?auto=compress&cs=tinysrgb&w=600',
    href: '/services/toddlers',
  },
  {
    title: 'Preschool',
    ageRange: '3 - 5 Years',
    description: 'Preparing children for kindergarten with steam-based activities.',
    imageUrl: 'https://images.pexels.com/photos/8612992/pexels-photo-8612992.jpeg?auto=compress&cs=tinysrgb&w=600',
    href: '/services/preschool',
  },
  {
    title: 'After-School',
    ageRange: '6 Years+',
    description: 'Providing homework help and enrichment programs for school-age kids.',
    imageUrl: 'https://images.pexels.com/photos/8613089/pexels-photo-8613089.jpeg?auto=compress&cs=tinysrgb&w=600',
    href: '/services/after-school',
  },
];
---

<BaseLayout
  title="Marietta Childcare - Where Children Learn, Grow, and Thrive"
  description="Providing a safe, nurturing, and high-quality early education environment for your little ones to blossom into their best selves."
  canonical="/"
>
  <Hero
    title="Where Children"
    subtitle="Learn, Grow, and Thrive"
    description="Providing a safe, nurturing, and high-quality early education environment for your little ones to blossom into their best selves."
    badge="Enrollment Open 2024"
    imageUrl="https://images.pexels.com/photos/8613311/pexels-photo-8613311.jpeg?auto=compress&cs=tinysrgb&w=1200"
    imageAlt="Happy children playing with wooden blocks in a sunny classroom"
  />

  <section class="py-16">
    <h2 class="text-[#111815] dark:text-white text-3xl font-bold leading-tight tracking-tight text-center mb-12">
      Trusted by 500+ Local Families
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <TestimonialCard {...testimonial} />
      ))}
    </div>
  </section>

  <section class="py-16 bg-white dark:bg-white/5 rounded-lg px-8 lg:px-12 my-12">
    <div class="max-w-[800px] mb-12">
      <h2 class="text-primary text-sm font-black uppercase tracking-widest mb-2">The Marietta Advantage</h2>
      <h3 class="text-3xl font-black mb-4">Why Choose Us</h3>
      <p class="text-[#111815]/70 dark:text-white/70 text-lg">
        We offer a unique approach to early childhood education that focuses on the whole child—emotionally, socially, and academically.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="flex flex-col gap-4">
        <div class="size-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
          <span class="material-symbols-outlined">school</span>
        </div>
        <h4 class="text-xl font-bold">Experienced Educators</h4>
        <p class="text-[#111815]/70 dark:text-white/70">
          Our certified staff is dedicated to your child's individual growth and developmental milestones.
        </p>
      </div>
      <div class="flex flex-col gap-4">
        <div class="size-12 rounded-full bg-secondary/10 flex items-center justify-center text-secondary">
          <span class="material-symbols-outlined">verified_user</span>
        </div>
        <h4 class="text-xl font-bold">Safe & Nurturing</h4>
        <p class="text-[#111815]/70 dark:text-white/70">
          State-of-the-art secure facilities with a warm, home-like feel that kids love coming back to.
        </p>
      </div>
      <div class="flex flex-col gap-4">
        <div class="size-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
          <span class="material-symbols-outlined">extension</span>
        </div>
        <h4 class="text-xl font-bold">Play-Based Learning</h4>
        <p class="text-[#111815]/70 dark:text-white/70">
          A curriculum designed around discovery, exploration, and fun to foster a lifelong love of learning.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-black mb-4">Our Programs</h2>
      <p class="text-[#111815]/70 dark:text-white/70 max-w-[600px] mx-auto">
        Tailored learning experiences for every stage of early development.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {programs.map((program) => (
        <ServiceCard {...program} />
      ))}
    </div>
  </section>

  <section class="py-16">
    <div class="flex flex-col gap-24">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="w-full md:w-1/2">
          <div class="relative">
            <div class="absolute -top-4 -left-4 w-24 h-24 bg-secondary/10 rounded-full blur-xl"></div>
            <img
              class="rounded-xl shadow-lg w-full"
              src="https://images.pexels.com/photos/8613318/pexels-photo-8613318.jpeg?auto=compress&cs=tinysrgb&w=800"
              alt="Modern clean classroom with colorful chairs and tables"
            />
          </div>
        </div>
        <div class="w-full md:w-1/2">
          <h3 class="text-3xl font-black mb-6">Modern, Clean Facilities</h3>
          <p class="text-[#111815]/70 dark:text-white/70 text-lg mb-6">
            Our classrooms are designed with your child's safety and engagement in mind. From ergonomic furniture to age-appropriate learning zones, every detail is crafted to spark joy and curiosity.
          </p>
          <ul class="flex flex-col gap-3">
            <li class="flex items-center gap-3 text-sm font-semibold">
              <span class="material-symbols-outlined text-primary">check_circle</span>
              Sanitized Daily with Eco-Friendly Products
            </li>
            <li class="flex items-center gap-3 text-sm font-semibold">
              <span class="material-symbols-outlined text-primary">check_circle</span>
              Secure Key-Code Access Entry
            </li>
            <li class="flex items-center gap-3 text-sm font-semibold">
              <span class="material-symbols-outlined text-primary">check_circle</span>
              Interactive SMART Technology Zones
            </li>
          </ul>
        </div>
      </div>

      <div class="flex flex-col md:flex-row-reverse items-center gap-12">
        <div class="w-full md:w-1/2">
          <img
            class="rounded-xl shadow-lg w-full"
            src="https://images.pexels.com/photos/1094072/pexels-photo-1094072.jpeg?auto=compress&cs=tinysrgb&w=800"
            alt="Outdoor playground with soft turf and climbing structures"
          />
        </div>
        <div class="w-full md:w-1/2">
          <h3 class="text-3xl font-black mb-6">Safe Outdoor Play</h3>
          <p class="text-[#111815]/70 dark:text-white/70 text-lg mb-6">
            Fresh air and physical activity are vital. Our outdoor playground features high-impact safety surfacing and equipment designed for gross motor skill development.
          </p>
          <ul class="flex flex-col gap-3">
            <li class="flex items-center gap-3 text-sm font-semibold">
              <span class="material-symbols-outlined text-primary">check_circle</span>
              Fenced and Monitored Play Areas
            </li>
            <li class="flex items-center gap-3 text-sm font-semibold">
              <span class="material-symbols-outlined text-primary">check_circle</span>
              Age-Specific Playground Equipment
            </li>
            <li class="flex items-center gap-3 text-sm font-semibold">
              <span class="material-symbols-outlined text-primary">check_circle</span>
              Daily Supervised Physical Education
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <h2 class="text-3xl font-black text-center mb-12">Parent Resources</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <a class="bg-primary/5 hover:bg-primary/10 p-6 rounded-lg transition-all border border-primary/10" href="#">
        <span class="material-symbols-outlined text-primary mb-4 text-3xl">child_care</span>
        <h4 class="font-bold mb-2">Developmental Milestones</h4>
        <p class="text-sm opacity-70 italic">What to expect in the first 5 years.</p>
      </a>
      <a class="bg-secondary/5 hover:bg-secondary/10 p-6 rounded-lg transition-all border border-secondary/10" href="#">
        <span class="material-symbols-outlined text-secondary mb-4 text-3xl">restaurant</span>
        <h4 class="font-bold mb-2">Nutrition Guide</h4>
        <p class="text-sm opacity-70 italic">Healthy meal planning for active kids.</p>
      </a>
      <a class="bg-primary/5 hover:bg-primary/10 p-6 rounded-lg transition-all border border-primary/10" href="#">
        <span class="material-symbols-outlined text-primary mb-4 text-3xl">book</span>
        <h4 class="font-bold mb-2">Reading Lists</h4>
        <p class="text-sm opacity-70 italic">Top recommended books for toddlers.</p>
      </a>
      <a class="bg-secondary/5 hover:bg-secondary/10 p-6 rounded-lg transition-all border border-secondary/10" href="#">
        <span class="material-symbols-outlined text-secondary mb-4 text-3xl">event</span>
        <h4 class="font-bold mb-2">Parent Portal</h4>
        <p class="text-sm opacity-70 italic">Login to view classroom updates.</p>
      </a>
    </div>
  </section>

  <section class="py-16 max-w-[800px] mx-auto">
    <h2 class="text-3xl font-black text-center mb-12">Frequently Asked Questions</h2>
    <div class="space-y-4">
      <details class="group bg-white dark:bg-white/5 rounded-lg border border-[#f0f4f3] dark:border-white/10 overflow-hidden" open>
        <summary class="flex items-center justify-between p-6 cursor-pointer font-bold">
          What are your operating hours?
          <span class="material-symbols-outlined transition-transform group-open:rotate-180">expand_more</span>
        </summary>
        <div class="px-6 pb-6 text-[#111815]/70 dark:text-white/70">
          We are open Monday through Friday, from 6:30 AM to 6:30 PM, to accommodate working families.
        </div>
      </details>
      <details class="group bg-white dark:bg-white/5 rounded-lg border border-[#f0f4f3] dark:border-white/10 overflow-hidden">
        <summary class="flex items-center justify-between p-6 cursor-pointer font-bold">
          What is your teacher-to-child ratio?
          <span class="material-symbols-outlined transition-transform group-open:rotate-180">expand_more</span>
        </summary>
        <div class="px-6 pb-6 text-[#111815]/70 dark:text-white/70">
          We maintain ratios that exceed state requirements to ensure every child receives personalized attention. For infants, our ratio is 1:4; for toddlers 1:6; and for preschool 1:10.
        </div>
      </details>
      <details class="group bg-white dark:bg-white/5 rounded-lg border border-[#f0f4f3] dark:border-white/10 overflow-hidden">
        <summary class="flex items-center justify-between p-6 cursor-pointer font-bold">
          Do you provide meals?
          <span class="material-symbols-outlined transition-transform group-open:rotate-180">expand_more</span>
        </summary>
        <div class="px-6 pb-6 text-[#111815]/70 dark:text-white/70">
          Yes, we provide a balanced breakfast, hot lunch, and two nutritious snacks daily, all prepared fresh on-site.
        </div>
      </details>
      <details class="group bg-white dark:bg-white/5 rounded-lg border border-[#f0f4f3] dark:border-white/10 overflow-hidden">
        <summary class="flex items-center justify-between p-6 cursor-pointer font-bold">
          What security measures are in place?
          <span class="material-symbols-outlined transition-transform group-open:rotate-180">expand_more</span>
        </summary>
        <div class="px-6 pb-6 text-[#111815]/70 dark:text-white/70">
          Our facility features a single point of entry with biometric/PIN access, CCTV in all classrooms and common areas, and all visitors must be pre-authorized and verified.
        </div>
      </details>
    </div>
  </section>

  <CTASection
    title="Ready to give your child the best start?"
    description="Join our community today. Schedule a private tour to meet our educators and see our learning environments in person."
  />
</BaseLayout>
