---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services'))
  .filter(s => s.data.published)
  .sort((a, b) => (a.data.priority || 0) - (b.data.priority || 0));
---

<BaseLayout
  title="Our Programs - Marietta Childcare"
  description="Explore our comprehensive childcare programs designed for every stage of early development, from infants to school-age children."
  canonical="/services"
>
  <section class="py-12">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-black mb-4">Our Programs</h1>
      <p class="text-[#111815]/70 dark:text-white/70 max-w-[700px] mx-auto text-lg">
        Tailored learning experiences for every stage of early development. We provide age-appropriate curriculum designed to nurture your child's growth emotionally, socially, and academically.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <ServiceCard
          title={service.data.title}
          ageRange={service.data.ageRange}
          description={service.data.description}
          imageUrl={service.data.heroImage}
          href={`/services/${service.slug}/`}
        />
      ))}
    </div>
  </section>

  <section class="py-16 bg-white dark:bg-white/5 rounded-lg px-8 lg:px-12 my-12">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-black mb-4">Why Parents Choose Our Programs</h2>
      <p class="text-[#111815]/70 dark:text-white/70 max-w-[600px] mx-auto">
        Each program is built on a foundation of safety, learning, and love.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="flex flex-col gap-4 text-center">
        <div class="size-16 rounded-full bg-primary/10 flex items-center justify-center text-primary mx-auto">
          <span class="material-symbols-outlined text-[32px]">favorite</span>
        </div>
        <h4 class="text-xl font-bold">Nurturing Environment</h4>
        <p class="text-[#111815]/70 dark:text-white/70">
          A warm, caring atmosphere where every child feels valued and loved.
        </p>
      </div>
      <div class="flex flex-col gap-4 text-center">
        <div class="size-16 rounded-full bg-secondary/10 flex items-center justify-center text-secondary mx-auto">
          <span class="material-symbols-outlined text-[32px]">psychology</span>
        </div>
        <h4 class="text-xl font-bold">Developmental Focus</h4>
        <p class="text-[#111815]/70 dark:text-white/70">
          Activities designed to support key milestones at each stage.
        </p>
      </div>
      <div class="flex flex-col gap-4 text-center">
        <div class="size-16 rounded-full bg-primary/10 flex items-center justify-center text-primary mx-auto">
          <span class="material-symbols-outlined text-[32px]">groups</span>
        </div>
        <h4 class="text-xl font-bold">Small Class Sizes</h4>
        <p class="text-[#111815]/70 dark:text-white/70">
          Low teacher-to-child ratios ensure personalized attention.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 text-center">
    <div class="bg-gradient-to-br from-primary to-[#0da36a] rounded-lg p-12 text-white">
      <h2 class="text-4xl font-black mb-4">Ready to Enroll?</h2>
      <p class="text-white/90 text-lg mb-8 max-w-[500px] mx-auto">
        Schedule a tour to see our programs in action and meet our amazing team.
      </p>
      <button class="bg-white text-primary px-10 py-4 rounded-full font-black text-lg hover:scale-105 transition-transform shadow-xl">
        Schedule a Tour
      </button>
    </div>
  </section>
</BaseLayout>
