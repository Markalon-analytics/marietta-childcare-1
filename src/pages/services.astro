---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LeadCTA from '../components/LeadCTA.astro';
import PageHero from '../components/PageHero.astro';
import { images, programPages } from '../data/site';

const serviceLinks = [
  { label: 'Infant Care', href: '/services/infant-care', page: programPages.find((page) => page.slug === 'infant-care') },
  { label: 'Toddler Care', href: '/services/toddlers', page: programPages.find((page) => page.slug === 'toddler-program') },
  { label: 'Preschool', href: '/services/preschool', page: programPages.find((page) => page.slug === 'preschool') },
  { label: 'After School', href: '/services/after-school', page: programPages.find((page) => page.slug === 'after-school') },
].filter((item) => item.page);
---

<BaseLayout
  title="BBMA Child Care Services Near Marietta | Marietta Childcare"
  description="BBMA child care services near Marietta for infants, toddlers, preschoolers, and school-age children. Compare programs and choose a location."
  canonical="/services/"
>
  <PageHero
    title="BBMA Child Care Services"
    description="Start with the programs Marietta-area parents look for most before choosing a Big Blue Marble Academy location."
    image={images.classroom}
    eyebrow="Services"
  />

  <section class="py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {serviceLinks.map(({ label, href, page }) => (
        <a href={href} class="rounded-lg border border-[#e4ece8] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
          <Icon name="heart" class="mb-4 size-7 text-primary" />
          <h2 class="text-xl font-black">{label}</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#111815]/70">{page.description}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-primary">
            Learn more <Icon name="arrow" class="size-4" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <LeadCTA />
</BaseLayout>
