---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, canonical, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      noindex={noindex}
    />
  </head>
  <body class="overflow-x-hidden bg-background-light dark:bg-background-dark text-[#111815] dark:text-white transition-colors duration-300">
    <Header />
    <main class="max-w-[1280px] mx-auto px-6 lg:px-20">
      <slot />
    </main>
    <Footer />
  </body>
</html>
