---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
}

const { title, description, canonical, image } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} image={image}>
  <article class="prose lg:prose-lg max-w-none py-12">
    <slot />
  </article>
</BaseLayout>
