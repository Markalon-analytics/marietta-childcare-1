---
const navItems = [
  { label: 'About', href: '#' },
  { label: 'Programs', href: '/services' },
  { label: 'Gallery', href: '#' },
  { label: 'Resources', href: '#' },
  { label: 'Contact', href: '#' },
];
---

<nav class="hidden md:flex flex-1 justify-center gap-8">
  {navItems.map((item) => (
    <a class="text-sm font-semibold hover:text-primary transition-colors" href={item.href}>
      {item.label}
    </a>
  ))}
</nav>
