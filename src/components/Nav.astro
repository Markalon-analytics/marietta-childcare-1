---
import { siteInfo } from '../data/site';

const navItems = [
  { label: 'About', href: '/about' },
  { label: 'Programs', href: '/programs' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Solutions', href: '/solutions' },
  { label: 'Find a Location', href: siteInfo.leadPath },
];
---

<nav class="hidden md:flex flex-1 justify-center gap-8">
  {navItems.map((item) => (
    <a class="text-sm font-semibold hover:text-primary transition-colors" href={item.href}>
      {item.label}
    </a>
  ))}
</nav>
