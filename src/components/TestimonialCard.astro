---
interface Props {
  name: string;
  role: string;
  testimonial: string;
  imageUrl: string;
  rating?: number;
}

const { name, role, testimonial, imageUrl, rating = 5 } = Astro.props;
---

<div class="bg-white dark:bg-white/5 p-8 rounded-lg shadow-sm border border-[#f0f4f3] dark:border-white/10">
  <div class="flex items-center gap-4 mb-4">
    <div
      class="size-12 rounded-full bg-cover bg-center"
      style={`background-image: url("${imageUrl}");`}
    >
    </div>
    <div>
      <p class="font-bold">{name}</p>
      <p class="text-xs text-primary font-medium">{role}</p>
    </div>
  </div>
  <div class="flex gap-1 mb-4 text-secondary">
    {Array.from({ length: rating }).map(() => (
      <span class="material-symbols-outlined text-[20px]">star</span>
    ))}
  </div>
  <p class="text-[#111815]/80 dark:text-white/80 leading-relaxed italic">"{testimonial}"</p>
</div>
