---
interface Props {
  name: string;
  class?: string;
  title?: string;
}

const { name, class: className = 'size-5', title } = Astro.props;

const icons: Record<string, string> = {
  star: '<path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2.6z"/>',
  school: '<path d="M3 10.5 12 5l9 5.5-9 5.5-9-5.5z"/><path d="M7 13.2v4.1c1.4 1.1 3.1 1.7 5 1.7s3.6-.6 5-1.7v-4.1"/><path d="M21 10.7v5.8"/>',
  shield: '<path d="M12 3 5 6v5.4c0 4.4 2.8 8.3 7 9.6 4.2-1.3 7-5.2 7-9.6V6l-7-3z"/><path d="m9 12 2 2 4-4"/>',
  puzzle: '<path d="M8 3h5v4a2 2 0 1 0 0 4v4H8a2 2 0 1 1-4 0v-4h4V7H4a2 2 0 1 1 4 0V3z"/><path d="M13 11h4v4a2 2 0 1 0 0 4h-4v-4"/>',
  check: '<path d="m5 12 4 4 10-10"/>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.7.6 2.5a2 2 0 0 1-.4 2.1L8 9.6a16 16 0 0 0 6.4 6.4l1.3-1.3a2 2 0 0 1 2.1-.4c.8.3 1.6.5 2.5.6A2 2 0 0 1 22 16.9z"/>',
  map: '<path d="M9 18 3 21V6l6-3 6 3 6-3v15l-6 3-6-3z"/><path d="M9 3v15"/><path d="M15 6v15"/>',
  mail: '<path d="M4 4h16v16H4z"/><path d="m4 7 8 6 8-6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  calendar: '<path d="M5 4h14v16H5z"/><path d="M8 2v4"/><path d="M16 2v4"/><path d="M5 9h14"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/>',
  book: '<path d="M4 4h7a3 3 0 0 1 3 3v14a3 3 0 0 0-3-3H4z"/><path d="M20 4h-6a3 3 0 0 0-3 3"/>',
  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  music: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  sparkles: '<path d="m12 3 1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3z"/><path d="m19 14 .8 2.2L22 17l-2.2.8L19 20l-.8-2.2L16 17l2.2-.8L19 14z"/><path d="m5 14 .8 2.2L8 17l-2.2.8L5 20l-.8-2.2L2 17l2.2-.8L5 14z"/>',
  home: '<path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
};

const icon = icons[name] ?? icons.sparkles;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden={title ? 'false' : 'true'}
  role={title ? 'img' : undefined}
  fill={name === 'star' ? 'currentColor' : 'none'}
  stroke={name === 'star' ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {title && <title>{title}</title>}
  <Fragment set:html={icon} />
</svg>
