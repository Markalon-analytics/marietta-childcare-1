---
interface Props {
  title: string;
  ageRange: string;
  description: string;
  imageUrl: string;
  href: string;
}

const { title, ageRange, description, imageUrl, href } = Astro.props;
---

<div class="group bg-white dark:bg-white/5 rounded-lg overflow-hidden border border-[#f0f4f3] dark:border-white/10 hover:shadow-xl transition-all hover:-translate-y-2">
  <div
    class="h-40 bg-cover bg-center"
    style={`background-image: url("${imageUrl}");`}
  >
  </div>
  <div class="p-6">
    <h4 class="text-xl font-bold mb-1">{title}</h4>
    <p class="text-sm text-primary font-semibold mb-3">{ageRange}</p>
    <p class="text-sm text-[#111815]/70 dark:text-white/70 mb-4">{description}</p>
    <a class="text-sm font-bold text-primary hover:underline transition-all" href={href}>
      Learn More
    </a>
  </div>
</div>
