---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  badge?: string;
  imageUrl: string;
  imageAlt: string;
}

const { title, subtitle, description, badge = 'Enrollment Open 2024', imageUrl, imageAlt } = Astro.props;
---

<section class="py-12 lg:py-20 @container">
  <div class="flex flex-col gap-10 @[864px]:flex-row items-center">
    <div class="flex flex-col gap-8 @[480px]:min-w-[400px] flex-1">
      <div class="flex flex-col gap-4 text-left">
        <span class="inline-block px-4 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest w-fit">
          {badge}
        </span>
        <h1 class="text-[#111815] dark:text-white text-5xl lg:text-6xl font-black leading-[1.1] tracking-tight">
          {title} <span class="text-primary">{subtitle}</span>
        </h1>
        <p class="text-[#111815]/70 dark:text-white/70 text-lg leading-relaxed max-w-[500px]">
          {description}
        </p>
      </div>
      <div class="flex flex-wrap gap-4">
        <button class="flex min-w-[180px] cursor-pointer items-center justify-center rounded-full h-14 px-8 bg-primary text-white text-base font-bold shadow-xl shadow-primary/30 hover:bg-primary/90 transition-all">
          Schedule Your Tour
        </button>
        <button class="flex min-w-[150px] cursor-pointer items-center justify-center rounded-full h-14 px-8 bg-white dark:bg-white/10 border-2 border-primary/20 text-primary dark:text-primary text-base font-bold hover:bg-primary/5 transition-all">
          Our Programs
        </button>
      </div>
    </div>
    <div class="w-full @[864px]:w-1/2 relative">
      <div class="absolute inset-0 bg-primary/10 rounded-xl -rotate-3 scale-105 -z-10"></div>
      <div
        class="w-full bg-center bg-no-repeat aspect-[4/3] bg-cover rounded-xl shadow-2xl overflow-hidden"
        style={`background-image: url("${imageUrl}");`}
        role="img"
        aria-label={imageAlt}
      >
      </div>
    </div>
  </div>
</section>
